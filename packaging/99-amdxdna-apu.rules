# /etc/udev/rules.d/99-amdxdna-apu.rules
# Permissions and group access for AMD XDNA NPU and AMDGPU DRM accelerators

# AMD XDNA NPU accelerator nodes
KERNEL=="accel[0-9]*", SUBSYSTEM=="accel", GROUP="render", MODE="0666"

# AMDGPU DRM Direct Rendering nodes
KERNEL=="renderD[0-9]*", SUBSYSTEM=="drm", GROUP="render", MODE="0666"

# AMD KFD (Kernel Fusion Driver) compute nodes for ROCm/HIP
KERNEL=="kfd", SUBSYSTEM=="kfd", GROUP="render", MODE="0666"
