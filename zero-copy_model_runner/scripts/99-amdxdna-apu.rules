# /etc/udev/rules.d/99-amdxdna-apu.rules
# Udev rules for AMD Ryzen AI APU hardware nodes (RDNA 3.5 iGPU + XDNA 2 NPU)

# AMD XDNA NPU Accelerator Nodes (/dev/accel/accel*)
SUBSYSTEM=="accel", KERNEL=="accel*", GROUP="render", MODE="0660"

# AMD DRM Render Nodes (/dev/dri/renderD*)
SUBSYSTEM=="drm", KERNEL=="renderD*", GROUP="render", MODE="0660"

# AMD KFD Compute Node (/dev/kfd)
KERNEL=="kfd", GROUP="render", MODE="0660"

# AMD Dma-Buf Sync & GEM Buffer access
SUBSYSTEM=="dma_buf", GROUP="render", MODE="0660"
