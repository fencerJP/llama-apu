# /etc/default/llama-server
# Configuration file for llama-server systemd daemon on AMD Ryzen AI APU

# Path to the GGUF or .q4nx model file (REQUIRED)
LLAMA_MODEL="/var/lib/llama/models/default-model.gguf"

# Network Host & Port
LLAMA_HOST="0.0.0.0"
LLAMA_PORT="8080"

# Context Window Size & Batch Size
LLAMA_CTX_SIZE="4096"
LLAMA_BATCH_SIZE="512"

# GPU/APU Offload Layers
LLAMA_NGL="99"

# APU Pipeline Preset: gpu-based | cpu-based | npu-based (Default: heterogeneous iGPU prefill + NPU decode)
LLAMA_APU_PRESET="--gpu-based"

# Additional CLI flags
LLAMA_EXTRA_ARGS="--no-warmup"
